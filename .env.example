# Backend environment variables. Copy to backend/.env and fill only what you need.
# The frontend never reads these values.

# Optional: raises GitHub API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Optional: enables AI Developer Lab tools. Never put this in frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GITHUB_API_BASE=https://api.github.com
GITHUB_TIMEOUT=15
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=300

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Absolute path to the repository root (used for static file serving).
APP_ROOT=
